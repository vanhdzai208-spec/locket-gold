# ==============================================================================
# Locket Web - Environment Configuration Template
# Sao chép file này thành .env (ở apps/backend/.env hoặc root .env)
# ==============================================================================

# Server Runtime
PORT=3001
NODE_ENV=production

# Frontend Origin for CORS (BẮT BUỘC Ở PRODUCTION)
# Ở production, server CHỈ chấp nhận CORS từ đúng origin này.
FRONTEND_URL=https://your-locket-web.example.com

# Backend Internal URL for Next.js Reverse Proxy (SEC-09: Tùy chọn)
# Dùng khi deploy trong Docker container, Kubernetes pod hoặc môi trường microservices
# Mặc định fallback nếu không đặt: http://127.0.0.1:3001
BACKEND_INTERNAL_URL=http://127.0.0.1:3001

# Session Secret (BẮT BUỘC Ở PRODUCTION: Tối thiểu 32 ký tự)
# Server sẽ dừng khởi động ngay lập tức (fail-fast) nếu biến này thiếu hoặc < 32 ký tự ở production.
# Tạo nhanh bằng lệnh: openssl rand -hex 32
SESSION_SECRET=replace_with_a_super_secret_key_at_least_32_characters_long!

# CSRF Secret (Tùy chọn ở production: tối thiểu 32 ký tự)
# Nếu không đặt, hệ thống sẽ tự động dùng SESSION_SECRET để sinh chữ ký HMAC cho CSRF token.
CSRF_SECRET=replace_with_a_csrf_secret_at_least_32_characters_long!

# Cookie SameSite ('lax' hoặc 'none')
# Dùng 'lax' nếu Frontend và Backend cùng domain (hoặc qua Next.js rewrite).
# Dùng 'none' nếu Frontend và Backend khác domain (khi đó Secure bắt buộc là true).
COOKIE_SAME_SITE=lax

# Locket & Firebase Configuration
LOCKET_API_BASE_URL=https://api.locketcamera.com
FIREBASE_API_KEY=AIzaSyCQngaaXQIfJaH0aS2l7REgIjD7nL431So
FIREBASE_PROJECT_ID=locket-4252a
FIREBASE_STORAGE_BUCKET=locket-img

# Firebase AppCheck Token (Tùy chọn: ghi đè token AppCheck nếu cần cập nhật token mới)
FIREBASE_APPCHECK_TOKEN=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-key-or-service-role-key

# Locket Gold Master Bot (Tùy chọn: dùng để tra cứu username cho cổng Public /gold)
LOCKET_BOT_EMAIL=your_secondary_locket_email@example.com
LOCKET_BOT_PASSWORD=your_secondary_locket_password

